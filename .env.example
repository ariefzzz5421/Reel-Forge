# Set these server-side only. No NEXT_PUBLIC_ prefix.
# Direct Gemini research. Create this key in Google AI Studio.
GEMINI_API_KEY=
# Optional Tavily key for a larger, account-specific web-search allowance.
# Without this, name-only research tries Tavily's rate-limited keyless mode.
TAVILY_API_KEY=
# Optional generic provider adapters. Research URL takes precedence over Gemini.
REEL_FORGE_RESEARCH_API_URL=
REEL_FORGE_VIDEO_API_URL=
# This key authenticates the generic adapters, NOT Gemini.
REEL_FORGE_API_KEY=
